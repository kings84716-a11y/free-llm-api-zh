# 免费 API key 库 — 注册后把 key 填这里，daily_digest.py 会自动实测额度/存活
# 当前已接: OPENROUTER_API_KEY（Mac OpenClaw 在用）。其余注册后取消注释填入。
# 本文件权限 chmod 600，不要提交 git。

# OpenRouter（已在 Mac OpenClaw 用作 utility 免费模型）
# OPENROUTER_API_KEY=sk-or-v1-xxxx

# Groq — https://console.groq.com/keys （邮箱即可，不要手机，1000 RPD）
# GROQ_API_KEY=gsk_xxxx

# Cloudflare Workers AI — https://dash.cloudflare.com （需 CF_API_TOKEN + CF_ACCOUNT_ID）
# CF_API_TOKEN=xxxx
# CF_ACCOUNT_ID=xxxx

# Google Gemini — https://aistudio.google.com/apikey （Google 登录，额度最大）
# GEMINI_API_KEY=AIzaXXXX

# Cerebras — https://cloud.cerebras.ai （14400 RPD，最快）
# CEREBRAS_API_KEY=xxxx

# 国内（需实名，国内机器直连快，按需）
# SILICONFLOW_API_KEY=
# MODELSCOPE_API_TOKEN=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
